# Copy to .env.local for local dev. On Vercel, add the same keys under
# Project Settings -> Environment Variables. Never commit real values.

# --- Supabase (Project Settings -> API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key. Safe in the browser; RLS protects the data.
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Local-only, for scripts. Never set these on Vercel.
# SUPABASE_DB_URL: Connect -> Session pooler URI (used by npm run db:migrate)
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Secret key: bypasses RLS. Used only by npm run embed:docs.
SUPABASE_SECRET_KEY=

# --- Groq: generates every AI step (server-side only) ---
GROQ_API_KEY=gsk_xxx
# Optional. Defaults to openai/gpt-oss-120b with reasoning_effort=medium.
GROQ_MODEL=
GROQ_REASONING_EFFORT=
# Optional per-call timeout in ms (default 60000).
AI_TIMEOUT_MS=

# --- Typesafe AI: independent cross-check of pain/fit/trigger (optional) ---
# Can only lower a rating, and only when >= 75% confident.
TYPESAFE_AI_API_KEY=
TYPESAFE_AI_BASE_URL=https://api.typesafe.ai
TYPESAFE_AI_MODEL=jev-latest
# Set to false to turn the cross-check off while keeping the key.
TYPESAFE_CROSSCHECK=

# --- Reddit (optional): free "script" app at reddit.com/prefs/apps ---
# Without these, Reddit allows about one search a minute from your network.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Google (optional): one key for "Search Google" (Places API (New)) and
# PageSpeed scores in audits. Google Cloud -> APIs & Services -> Credentials.
GOOGLE_API_KEY=

# --- Real sending. Leave false for draft mode. ---
SEND_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SEND_FROM="Alex <alex@example.com>"
UNSUBSCRIBE_URL=https://example.com/unsubscribe
